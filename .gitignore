# ── Data: ignore all raw and processed data ────────────────────────────────
data/raw/**
data/processed/**
data/download_log.txt

# Keep folder structure and documentation
!data/**/
!**/.gitkeep
!data/README_data.md

# Keep .gitkeep files to preserve empty directories
!**/.gitkeep

# ── NetLogo ────────────────────────────────────────────────────────────────
*.nlogo~          # NetLogo backup files
model/__pycache__/

# ── R ──────────────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.Rproj
# renv: track renv.lock but not the library itself
renv/library/
renv/staging/
renv/sandbox/
renv/.cache/
# Do track these renv files:
!renv/activate.R
!renv/settings.json
!renv.lock

# ── Outputs — figures and tables are regenerated, don't version them ───────
outputs/figures/*.pdf
outputs/figures/*.png
outputs/figures/*.svg
outputs/tables/*.csv
outputs/tables/*.xlsx
# Exception: keep a sample figure for the README if needed
!outputs/figures/README_sample.png

# ── OS / IDE ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Secrets / credentials ──────────────────────────────────────────────────
.env
*.pem
*.key
secrets/
